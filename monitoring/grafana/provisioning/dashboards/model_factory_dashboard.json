{
  "uid": "model-factory-mon",
  "title": "Model Factory Monitoring & Drift Dashboard",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "model_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_ds"
        },
        "query": "label_values(model_predictions_total, model_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Predictions Served ($model_name)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "targets": [
        {
          "expr": "sum(model_predictions_total{model_name=~\"$model_name\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Real-Time Feature Data Drift Z-Score ($model_name)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(model_feature_drift_zscore{model_name=~\"$model_name\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Last Prediction Output ($model_name)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "targets": [
        {
          "expr": "model_last_prediction_value{model_name=~\"$model_name\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
